# Copy to .env next to docker-compose.yml (never commit real credentials)
S3_ACCESS_KEY=your_silo_access_key
S3_SECRET_KEY=your_silo_secret_key

# Optional: isolated Google Drive folder via rclone (e.g. gdrive:OArc-Drop)
# Place a dedicated rclone.conf inside ./secrets/rclone.conf
GDRIVE_REMOTE_DIR=gdrive:OArc-Drop
